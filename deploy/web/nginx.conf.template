# Rendered at container start by entrypoint.sh. Only ${PORT}, ${API_UPSTREAM}
# and ${RESOLVER} are substituted; nginx's own $variables are left intact.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Container health for the platform. Answers without touching the API, so a
    # sleeping or broken API cannot make the website look down.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API proxy. The API serves /football/..., so /api is stripped,
    # matching the Express api-server in the original Replit setup.
    #
    # proxy_pass uses a variable so the upstream hostname is re-resolved at
    # request time. A literal hostname is resolved once at startup, and nginx
    # would keep sending traffic to a stale address after the API redeploys.
    resolver ${RESOLVER} valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        # The API may be on HTTPS behind a shared edge that routes on SNI.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A free-tier API that has spun down takes about a minute to wake.
        proxy_connect_timeout 75s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routing: any other path loads the app, which picks the page.
    # index.html is never cached, so a deploy is picked up on the next load.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
